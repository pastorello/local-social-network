{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue"],
  "env": {
    "browser": true
  },
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["src/**/__tests__/**"],
      "plugins": ["vitest"],
      "rules": {
        "vitest/require-mock-type-parameters": "off"
      }
    }
  ]
}
