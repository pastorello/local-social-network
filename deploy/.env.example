# Copy to deploy/.env on the server and fill in. Never commit the filled copy.

# The one hostname the whole thing answers on. Both halves share it, so there
# is no second name to configure and no CORS to get wrong.
DOMAIN=viveregaeta.it
# Let's Encrypt sends expiry warnings here.
ACME_EMAIL=you@example.org

# Also signs JWTs, so rotating it logs everyone out. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

POSTGRES_DB=viveregaeta
POSTGRES_USER=viveregaeta
POSTGRES_PASSWORD=

# Invite and password-reset e-mail (spec A3/A4). Without a working sender,
# approving a collaboration request sends nobody anything.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@viveregaeta.it
