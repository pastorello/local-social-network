# Copy to deploy/.env on the server and fill in. Never commit the filled copy.

# The one hostname the whole thing answers on. Both halves share it, so there
# is no second name to configure and no CORS to get wrong.
DOMAIN=viveregaeta.it
# Let's Encrypt sends expiry warnings here.
ACME_EMAIL=you@example.org

# Also signs JWTs, so rotating it logs everyone out. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Keep the single quotes: the key usually contains a `$`, and Compose reads an
# unquoted `$abc` as a variable and cuts it out of the key without an error.
DJANGO_SECRET_KEY=''

POSTGRES_DB=viveregaeta
POSTGRES_USER=viveregaeta
POSTGRES_PASSWORD=

# Invite and password-reset e-mail (spec A3/A4). Without a working sender,
# approving a collaboration request sends nobody anything.
# Brevo's free plan (ADR-0009): 587 with STARTTLS. The user is the SMTP login
# Brevo shows under SMTP & API — not your account e-mail — and the password is
# an SMTP key generated there; keep it between single quotes.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=''
EMAIL_USE_TLS=true
# The address must be a sender Brevo has verified, on the authenticated domain.
DEFAULT_FROM_EMAIL='Vivere Gaeta <noreply@viveregaeta.it>'
